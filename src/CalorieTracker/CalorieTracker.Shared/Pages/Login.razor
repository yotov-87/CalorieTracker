@page "/login"
@using System.ComponentModel.DataAnnotations
@using System.Net.Http.Json
@using CalorieTracker.Shared.DTOs
@using CalorieTracker.Shared.Services
@inject HttpClient Http
@inject ClientAuthStateService AuthState
@implements IDisposable
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))

<PageTitle>@(AuthState.IsAuthenticated ? "Account" : (isRegisterMode ? "Register" : "Sign In")) - CalorieTracker</PageTitle>

<div class="d-flex justify-content-center align-items-center py-4">
    <div class="card shadow-sm border-0" style="width: 100%; max-width: 420px; border-radius: 12px;">
        <div class="card-body p-4 p-md-5">
            @if (AuthState.IsAuthenticated)
            {
                <div class="text-center">
                    <div class="alert alert-success mb-4" role="alert">
                        <h4 class="alert-heading mb-1">
                            Welcome, @(AuthState.CurrentUser?.FullName ?? AuthState.CurrentUser?.Email ?? "User")!
                        </h4>
                        <p class="mb-0 small">@AuthState.CurrentUser?.Email</p>
                    </div>

                    <button type="button" class="btn btn-outline-danger w-100 py-2 fw-semibold"
                            @onclick="HandleLogoutAsync">
                        Logout
                    </button>
                </div>
            }
            else
            {
                <h2 class="text-center mb-4 fw-bold">@(isRegisterMode ? "Create Account" : "Sign In")</h2>

                @if (!string.IsNullOrEmpty(statusMessage))
                {
                    <div class="alert @(isError ? "alert-danger" : "alert-success") py-2" role="alert">
                        @statusMessage
                    </div>
                }

                @if (!isRegisterMode)
                {
                    <EditForm Model="loginModel" OnValidSubmit="HandleLoginAsync" FormName="LoginForm">
                        <DataAnnotationsValidator />

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Email</label>
                            <InputText @bind-Value="loginModel.Email" class="form-control" placeholder="Enter your email" />
                            <ValidationMessage For="@(() => loginModel.Email)" class="text-danger small" />
                        </div>

                        <div class="mb-3">
                            <div class="d-flex justify-content-between">
                                <label class="form-label fw-semibold">Password</label>
                                <a href="login" @onclick:preventDefault class="small text-decoration-none">Forgot password?</a>
                            </div>
                            <InputText @bind-Value="loginModel.Password" type="password" class="form-control" placeholder="Enter your password" />
                            <ValidationMessage For="@(() => loginModel.Password)" class="text-danger small" />
                        </div>

                        <button type="submit" class="btn w-100 text-white fw-semibold py-2 mt-2"
                                style="background-color: #05163d;" disabled="@isSubmitting">
                            @(isSubmitting ? "Signing in..." : "Sign In")
                        </button>
                    </EditForm>

                    <div class="text-center mt-4 small">
                        Don't have an account?
                        <a href="login" @onclick="ToggleMode" @onclick:preventDefault class="fw-semibold">Create Account</a>
                    </div>
                }
                else
                {
                    <EditForm Model="registerModel" OnValidSubmit="HandleRegisterAsync" FormName="RegisterForm">
                        <DataAnnotationsValidator />

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Name</label>
                            <InputText @bind-Value="registerModel.FullName" class="form-control" placeholder="Enter your name" />
                            <ValidationMessage For="@(() => registerModel.FullName)" class="text-danger small" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Email</label>
                            <InputText @bind-Value="registerModel.Email" class="form-control" placeholder="Enter your email" />
                            <ValidationMessage For="@(() => registerModel.Email)" class="text-danger small" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Password</label>
                            <InputText @bind-Value="registerModel.Password" type="password" class="form-control" placeholder="Create a password" />
                            <ValidationMessage For="@(() => registerModel.Password)" class="text-danger small" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Confirm Password</label>
                            <InputText @bind-Value="registerModel.ConfirmPassword" type="password" class="form-control" placeholder="Repeat your password" />
                            <ValidationMessage For="@(() => registerModel.ConfirmPassword)" class="text-danger small" />
                        </div>

                        <button type="submit" class="btn w-100 text-white fw-semibold py-2 mt-2"
                                style="background-color: #05163d;" disabled="@isSubmitting">
                            @(isSubmitting ? "Creating account..." : "Create Account")
                        </button>
                    </EditForm>

                    <div class="text-center mt-4 small">
                        Already have an account?
                        <a href="login" @onclick="ToggleMode" @onclick:preventDefault class="fw-semibold">Sign In</a>
                    </div>
                }
            }
        </div>
    </div>
</div>

@code {
    private bool isRegisterMode;
    private bool isSubmitting;
    private bool isError;
    private string? statusMessage;

    private LoginInputModel loginModel = new();
    private RegisterInputModel registerModel = new();

    protected override async Task OnInitializedAsync()
    {
        AuthState.OnChange += StateHasChanged;
        await AuthState.InitializeAsync();
    }

    private void ToggleMode()
    {
        isRegisterMode = !isRegisterMode;
        statusMessage = null;
        isError = false;
    }

    private async Task HandleLoginAsync()
    {
        isSubmitting = true;
        statusMessage = null;
        isError = false;

        try
        {
            var request = new LoginRequestDto
            {
                Email = loginModel.Email,
                Password = loginModel.Password
            };

            var response = await Http.PostAsJsonAsync("/api/auth/login", request);
            var result = await response.Content.ReadFromJsonAsync<AuthResponseDto>();

            if (!response.IsSuccessStatusCode || result is null || !result.Success || string.IsNullOrWhiteSpace(result.Token))
            {
                isError = true;
                statusMessage = result?.Message ?? "Invalid email or password.";
                return;
            }

            await AuthState.SetSessionAsync(result);
            loginModel = new();
        }
        catch (Exception ex)
        {
            isError = true;
            statusMessage = ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task HandleRegisterAsync()
    {
        isSubmitting = true;
        statusMessage = null;
        isError = false;

        try
        {
            var request = new RegisterRequestDto
            {
                FullName = registerModel.FullName,
                Email = registerModel.Email,
                Password = registerModel.Password
            };

            var response = await Http.PostAsJsonAsync("/api/auth/register", request);
            var result = await response.Content.ReadFromJsonAsync<AuthResponseDto>();

            if (!response.IsSuccessStatusCode || result is null || !result.Success || string.IsNullOrWhiteSpace(result.Token))
            {
                isError = true;
                statusMessage = result?.Message ?? "Registration failed.";
                return;
            }

            await AuthState.SetSessionAsync(result);
            registerModel = new();
            isRegisterMode = false;
        }
        catch (Exception ex)
        {
            isError = true;
            statusMessage = ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task HandleLogoutAsync()
    {
        statusMessage = null;
        isError = false;
        await AuthState.LogoutAsync();
    }

    public void Dispose()
    {
        AuthState.OnChange -= StateHasChanged;
    }

    public class LoginInputModel
    {
        [Required(ErrorMessage = "Email is required.")]
        [EmailAddress(ErrorMessage = "Invalid email address.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Password is required.")]
        public string Password { get; set; } = string.Empty;
    }

    public class RegisterInputModel
    {
        [Required(ErrorMessage = "Name is required.")]
        public string FullName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Email is required.")]
        [EmailAddress(ErrorMessage = "Invalid email address.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Password is required.")]
        [MinLength(6, ErrorMessage = "Password must be at least 6 characters.")]
        public string Password { get; set; } = string.Empty;

        [Required(ErrorMessage = "Please confirm your password.")]
        [Compare(nameof(Password), ErrorMessage = "Passwords do not match.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}