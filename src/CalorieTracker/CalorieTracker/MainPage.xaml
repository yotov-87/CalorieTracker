<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:CalorieTracker"
             xmlns:shared="clr-namespace:CalorieTracker.Shared;assembly=CalorieTracker.Shared"
             x:Class="CalorieTracker.MainPage"
             BackgroundColor="{DynamicResource PageBackgroundColor}">

    <ContentPage.Padding>
        <OnPlatform x:TypeArguments="Thickness">
            <On Platform="Android" Value="0,36,0,0" />
        </OnPlatform>
    </ContentPage.Padding>

    <BlazorWebView x:Name="blazorWebView" HostPage="wwwroot/index.html">
        <BlazorWebView.RootComponents>
            <RootComponent Selector="#app" ComponentType="{x:Type shared:Routes}" />
        </BlazorWebView.RootComponents>
    </BlazorWebView>

</ContentPage>